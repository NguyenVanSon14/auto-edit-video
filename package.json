{
  "name": "auto-edit-video",
  "version": "1.0.0",
  "description": "Generate, render, and download polished vertical short videos",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
