# Copy this file to .env. Mock mode works without any API key.
PORT=3001
MOCK_AI=true

# AI_PROVIDER can be "gemini" or "openai" when MOCK_AI=false.
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-5-mini

# Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional local paths. Relative paths are resolved from the project directory.
DATA_DIR=./data
RENDER_DIR=./renders
